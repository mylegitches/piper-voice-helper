#!/usr/bin/env bash
# Installs piper1-gpl training (https://github.com/OHF-Voice/piper1-gpl) into
# .piper1-gpl/, which the studio's Train button uses by default.
#
# Needs: git, python3 (3.9+) with venv, build-essential, cmake, ninja-build.
# A CUDA GPU is strongly recommended for training.
set -euo pipefail

this_dir="$( cd "$( dirname "$0" )" && pwd )"
piper_dir="${this_dir}/../.piper1-gpl"
piper_ref="${PIPER_REF:-5b355b110aecf3de8f4e000ede1ce06831acff35}"

if [ ! -d "${piper_dir}/.git" ]; then
    git clone https://github.com/OHF-Voice/piper1-gpl.git "${piper_dir}"
fi

cd "${piper_dir}"
git fetch --depth 1 origin "${piper_ref}"
git checkout --detach FETCH_HEAD

python3 -m venv .venv
.venv/bin/pip install --upgrade pip wheel setuptools scikit-build
.venv/bin/pip install -e '.[train]'
# onnx export dependencies missing from piper1-gpl's [train] extras
.venv/bin/pip install onnx onnxscript

# Cython alignment + espeak-ng bridge (dev build, per docs/TRAINING.md)
./build_monotonic_align.sh
.venv/bin/python3 setup.py build_ext --inplace

.venv/bin/python3 -c 'import piper.train.vits.monotonic_align, piper.espeakbridge'
echo "piper1-gpl training installed: ${piper_dir}/.venv/bin/python3"
