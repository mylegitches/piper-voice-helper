#!/usr/bin/env bash
# Non-Docker install: creates .venv with the web app and piper1-gpl training.
# Needs: python3 (3.10+) with venv, git, ffmpeg, build-essential, cmake, ninja-build
set -euo pipefail

repo_dir="$( cd "$( dirname "$0" )/.." && pwd )"
cd "${repo_dir}"

python3 -m venv .venv
.venv/bin/pip install --upgrade pip
.venv/bin/pip install -r requirements.txt
script/install_piper "${repo_dir}/.venv/bin/python3" "${repo_dir}/.piper1-gpl"

echo
echo "Done. Start with: script/run   (then open http://localhost:8000)"
